# Safe-to-commit template: keep variable names only and never add real secrets here.
# Copy this file to .env and set local values there.

# Google OAuth / Gmail import secrets (set only when the integration is enabled)
GOOGLE_CLOUD_PROJECT_ID=looply-subscription-506608
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Secret: exactly 32 random bytes encoded as base64 (for example: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Public configuration (NEXT_PUBLIC_ values are exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
